{
  "name": "flux",
  "version": "1.0.0",
  "description": "Flux - Personal Cloud Storage",
  "type": "module",
  "scripts": {
    "build": "npm --prefix backend install && npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "start": "node backend/src/index.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"yellow,green\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node backend/src/index.js",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "keywords": [
    "cloud-storage",
    "supabase",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
